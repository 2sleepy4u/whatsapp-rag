# Copy to .env and adjust. All vars are optional.

# Where private data, the SQLite DB and the vector store live.
CHAT_RAG_DATA_DIR=./data

# Timezone used to interpret WhatsApp timestamps.
CHAT_RAG_TZ=Europe/Rome

# Ollama (used from Phase 3 onwards).
CHAT_RAG_OLLAMA_HOST=http://localhost:11434
CHAT_RAG_LLM_MODEL=qwen2.5:7b
CHAT_RAG_EMBED_MODEL=bge-m3

# Max tokens the LLM may generate per step (caps runaway/thinking output).
CHAT_RAG_LLM_NUM_PREDICT=1024
# Enable hidden reasoning for thinking models (qwen3). Off keeps tool calls fast.
CHAT_RAG_LLM_THINK=0

# Optional: replace the built-in agent system prompt with the contents of this file.
CHAT_RAG_SYSTEM_PROMPT_FILE=

# How message text is embedded: none = "Sender: text"; prevnext = include the
# previous/next message (needs reindexing; context_mode is hashed per message).
CHAT_RAG_EMBED_CONTEXT=none

# --- Voice-note transcription (Phase 7) ---
# auto = use whisper.cpp when bin+model are set, else faster-whisper (CPU).
CHAT_RAG_TRANSCRIBE_ENGINE=auto
# faster-whisper options (install with: uv sync --extra voice)
CHAT_RAG_WHISPER_MODEL=small
CHAT_RAG_WHISPER_LANGUAGE=it
CHAT_RAG_WHISPER_DEVICE=cpu
CHAT_RAG_WHISPER_COMPUTE_TYPE=int8
# whisper.cpp options (build with Vulkan for the RX 6650 XT). Leave empty to use faster-whisper.
CHAT_RAG_WHISPER_CPP_BIN=
CHAT_RAG_WHISPER_CPP_MODEL=
