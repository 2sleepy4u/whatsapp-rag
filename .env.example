# Copy to .env and adjust. All vars are optional.

# Where private data, the SQLite DB and the vector store live.
CHAT_RAG_DATA_DIR=./data

# Timezone used to interpret WhatsApp timestamps.
CHAT_RAG_TZ=Europe/Rome

# Ollama (used from Phase 3 onwards).
CHAT_RAG_OLLAMA_HOST=http://localhost:11434
CHAT_RAG_LLM_MODEL=qwen2.5:7b
CHAT_RAG_EMBED_MODEL=bge-m3

# Max tokens the LLM may generate per step (caps runaway/thinking output).
CHAT_RAG_LLM_NUM_PREDICT=1024
# Enable hidden reasoning for thinking models (qwen3). Off keeps tool calls fast.
CHAT_RAG_LLM_THINK=0
